{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0f9530df-413d-4732-a0bc-5f5160254cf1","database_name": "nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e9ee354959424205930307adb442c533" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
